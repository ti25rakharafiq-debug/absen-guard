<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orb_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_circle"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/orb_day_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_glass_pill"
        android:paddingLeft="8dp"
        android:paddingTop="2dp"
        android:paddingRight="8dp"
        android:paddingBottom="2dp"
        android:text="SENIN"
        android:textColor="#2E8B57"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/orb_time_big"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="07:00"
        android:textColor="#4338CA"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/orb_course_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="Pemasaran Industri"
        android:textColor="#0F172A"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/orb_room_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Ruang A405"
        android:textColor="#475569"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
