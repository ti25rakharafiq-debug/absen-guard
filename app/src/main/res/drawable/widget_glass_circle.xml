<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#E0EEF4FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:centerColor="#14F8FAFC"
                android:endColor="#38CBD5E1"
                android:startColor="#99F8FAFC" />
            <stroke
                android:width="1.5dp"
                android:color="#E6F8FAFC" />
        </shape>
    </item>
</layer-list>
