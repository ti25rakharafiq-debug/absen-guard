<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40F8FAFC">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="315"
                        android:endColor="#2563EB"
                        android:startColor="#4F46E5" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="#08F8FAFC"
                        android:startColor="#4DF8FAFC" />
                    <corners android:radius="18dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#80F8FAFC" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
