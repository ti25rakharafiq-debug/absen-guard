<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D9EEF4FF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#14F8FAFC"
                android:endColor="#38CBD5E1"
                android:startColor="#8CF8FAFC" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1.5dp"
                android:color="#E6F8FAFC" />
        </shape>
    </item>
</layer-list>
